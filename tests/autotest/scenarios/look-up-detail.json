{
  "name": "look-up-detail",
  "description": "A middle drag up at Detail makes the view flat and then looks above the horizon.",
  "setup": {
    "stage": "Detail",
    "cursor": [
      0.5,
      0.65
    ]
  },
  "steps": [
    {
      "drag": "middle",
      "at": [
        0.5,
        0.65
      ],
      "right": 0,
      "up": 450,
      "seconds": 1.5
    },
    {
      "wait": 0.3
    }
  ],
  "checks": [
