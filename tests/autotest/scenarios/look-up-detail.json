    {
      "rule": "change",
      "of": "raise",
      "min": 15
    },
    {
      "rule": "change",
      "of": "pitch",
      "max": -10
    }
  ],
  "offline": {
    "world": "flat",
    "fps": [
      30,
      60,
      144
    ]
